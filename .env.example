# Copy to .env and adjust. .env is git-ignored and never committed.
# Everything below has a working default: the lab runs with no .env at all.

# --- Application ---
APP_NAME="SAP AI Application Lab"
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ---
# SQLite (default, no server needed)
# DATABASE_URL=sqlite:///./data/sap_ai_lab.db
# PostgreSQL (optional, later)
# DATABASE_URL=postgresql+psycopg://sap_lab:password@localhost:5432/sap_ai_lab
DATABASE_ECHO=false

# --- Uploads (tabular: modules 1-5) ---
MAX_UPLOAD_BYTES=26214400          # 25 MB
MAX_ROWS_PER_UPLOAD=200000
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.json

# --- Document uploads (module 6, Contract Assistant) -------------------------
# Deliberately a separate allow list from the tabular uploads above, so growing
# one can never make a spreadsheet module start accepting PDFs.
MAX_DOCUMENT_BYTES=20971520        # 20 MB
MAX_DOCUMENT_PAGES=400
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.docx,.txt,.md
# Images are only accepted when an OCR provider below is configured.
ALLOWED_IMAGE_EXTENSIONS=.png,.jpg,.jpeg,.tif,.tiff
# A page holding fewer characters than this is treated as an image-only page.
MIN_CHARS_PER_TEXT_PAGE=40

# --- OCR provider ------------------------------------------------------------
# "none" is the default. Text-based PDF, DOCX and TXT need no OCR at all; with
# no provider configured, a scanned document is reported as unprocessable
# rather than analysed as an empty contract.
#   local                        - Tesseract, runs on this machine, no API cost
#                                  (needs the tesseract binary + pytesseract, Pillow)
#   aws_textract                 - billed by AWS per page
#   azure_document_intelligence  - billed by Azure per page
OCR_PROVIDER=none
OCR_LANGUAGE=eng

# AWS_TEXTRACT_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=...

# --- AI provider -------------------------------------------------------------
# "mock" is the default and needs no key. Set a key AND the provider name to
# use a real model. Keys are read from the environment only; they are never
# written to source, logs or API responses.
AI_PROVIDER=mock
AI_ENABLED=true
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Streamlit -> API --------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000

# --- CORS (future website) ---------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
