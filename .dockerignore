# Build context exclusions. Keep the image small and keep local state out of it.

.git
.gitignore
.github

# Local secrets - never copied into an image.
.env
*.key

# Python build/runtime artefacts
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local runtime data. data/sample/ IS copied (it is the demo dataset);
# uploads, exports and the SQLite file are not.
data/uploads/*
data/exports/*
data/*.db

# Documentation and examples are not needed to run the API. Listed explicitly
# rather than as `*.md`: the demo manifests live in data/sample/ and describe
# what each anomaly in the dataset is, which is worth keeping in the image
# alongside the data it documents.
docs/
examples/
PROJECT_2_HANDOFF.md
PROJECT_3_HANDOFF.md
CLAUDE.md

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
