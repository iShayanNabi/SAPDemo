  },
  "payment": {
    "description": "Payment term parsing and the company policy the extracted terms are checked against.",
    "net_days_patterns": [
      "net\\s*(?P<days>\\d{1,3})",
      "(?:within|after)\\s+(?P<days>\\d{1,3})\\s+(?:calendar\\s+|business\\s+|working\\s+)?days\\s+(?:of|from|after|following)",
      "payable\\s+(?:within\\s+)?(?P<days>\\d{1,3})\\s+days",
      "\\bNT\\s?(?P<days>\\d{1,3})\\b"
    ],
    "early_payment_discount_patterns": [
      "(?P<pct>\\d{1,2}(?:\\.\\d{1,2})?)\\s*(?:%|per\\s+cent|percent)\\s*(?:cash\\s+)?discount\\b.{0,40}?within\\s+(?P<days>\\d{1,3})\\s+(?:calendar\\s+)?days"
    ],
