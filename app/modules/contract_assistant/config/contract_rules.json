{
  "config_version": "1.0.0",
  "description": "Deterministic configuration for the SAP AI Application Lab Contract Assistant. Every clause pattern, confidence weight, date window and risk threshold lives here - no rule may hardcode one. Editing this file changes what the engine finds without touching a line of Python.",
  "extraction": {
    "description": "How much text a clause carries with it and when a match is discarded.",
    "excerpt_chars": 320,
    "max_excerpt_chars": 700,
    "min_confidence": 0.3,
    "max_instances_per_clause": 3,
    "context_chars_before": 60,
    "review_below_confidence": 0.55
  },
  "confidence": {
    "description": "Confidence is deterministic: it is built from the evidence the matcher actually saw, never guessed. Start at 'base', add 'heading_match' when the clause sits under a heading that names it, add 'primary_keyword' for the defining phrase, add 'secondary_keyword' per supporting phrase (capped), add 'value_extracted' when a number/date was parsed out of the clause, and subtract 'scattered_penalty' when the only evidence is spread across unrelated pages.",
    "base": 0.3,
    "heading_match": 0.32,
    "primary_keyword": 0.2,
    "secondary_keyword": 0.05,
    "max_secondary": 0.15,
    "value_extracted": 0.1,
    "scattered_penalty": 0.08,
    "minimum": 0.05,
    "maximum": 0.99
  },
  "sections": {
    "description": "How a heading is recognised in extracted text. PDF extraction discards blank lines, so headings are detected from numbering and capitalisation, never from spacing.",
    "min_heading_chars": 3,
    "max_heading_chars": 90,
    "max_heading_words": 12,
    "numbered_patterns": [
      "^\\s*(?P<number>\\d{1,2}(?:\\.\\d{1,2}){0,3})\\.?\\s+(?P<title>[A-Z][^.]{2,88})$",
      "^\\s*(?P<number>(?:ARTICLE|SECTION|CLAUSE|SCHEDULE|ANNEX|APPENDIX|EXHIBIT)\\s+[0-9IVXLC]{1,6})\\s*[.:\\-]?\\s*(?P<title>[A-Za-z][^.]{2,88})?$",
      "^\\s*(?P<number>\\([a-z]\\)|\\(\\d{1,2}\\))\\s+(?P<title>[A-Z][^.]{2,88})$"
    ],
    "uppercase_pattern": "^\\s*(?P<title>[A-Z][A-Z0-9 ,&'()/\\-]{2,88})\\s*$",
    "title_case_pattern": "^\\s*(?P<title>(?:[A-Z][a-zA-Z]*)(?:[ \\-](?:of|and|or|to|the|for|in|a|an|[A-Z][a-zA-Z]*)){0,9})\\s*$",
    "stop_words_in_heading": [
      "shall",
      "will",
      "hereby",
      "agrees",
      "means"
    ]
  },
  "document": {
    "description": "How the contract title and the parties are recognised.",
    "title_patterns": [
      "^\\s*(?P<title>[A-Z][A-Za-z0-9 ,&'()/\\-]{6,110}(?:AGREEMENT|CONTRACT|ORDER|TERMS|SOW|STATEMENT OF WORK|ADDENDUM|AMENDMENT))\\s*$",
      "^\\s*(?P<title>(?:MASTER|SERVICE|SERVICES|SUPPLY|SOFTWARE|LICENCE|LICENSE|MAINTENANCE|FRAMEWORK|CONSULTING|PURCHASE)[A-Z ]{0,60}AGREEMENT)\\s*$"
    ],
    "title_scan_lines": 40,
    "party_patterns": [
      "(?P<name>[A-Z][A-Za-z0-9.&'\\-]{1,30}(?:[ \\-][A-Za-z0-9.&'\\-]{1,30}){0,5}[ ](?:GmbH|AG|SE|BV|B\\.V\\.|NV|N\\.V\\.|SA|S\\.A\\.|SAS|Srl|S\\.r\\.l\\.|Ltd\\.?|Limited|LLC|L\\.L\\.C\\.|Inc\\.?|PLC|plc|Oy|AB|A/S|ApS|Pty Ltd))(?![A-Za-z])",
      "\\bbetween\\s+(?P<name>[A-Z][A-Za-z0-9.&'\\- ]{2,60}?)\\s*(?:\\(|,\\s*(?:a|an|the)\\b|\\band\\b)",
      "\\band\\s+(?P<name>[A-Z][A-Za-z0-9.&'\\- ]{2,60}?)\\s*\\(\\s*(?:the|\"|')"
    ],
    "party_stop_words": [
      "this",
      "the",
      "and",
      "between",
      "by",
      "of",
      "made",
      "dated",
      "entered",
      "into"
    ],
    "party_reject_words": [
      "agreement",
      "contract",
      "schedule",
      "annex",
      "appendix",
      "exhibit",
      "addendum",
      "parties",
      "party"
    ],
    "role_patterns": {
      "customer": [
        "\\bcustomer\\b",
        "\\bbuyer\\b",
        "\\bpurchaser\\b",
        "\\bclient\\b",
        "\\bprincipal\\b"
      ],
      "supplier": [
        "\\bsupplier\\b",
        "\\bvendor\\b",
        "\\bcontractor\\b",
        "\\bservice provider\\b",
        "\\bprovider\\b",
        "\\bseller\\b",
        "\\blicensor\\b"
      ]
    },
    "party_scan_chars": 4000,
    "max_parties": 6
  },
  "dates": {
    "description": "Date parsing and the windows used to report a contract as expiring. day_first controls how an ambiguous 03/04/2026 is read - true means 3 April, which is the European convention SAP exports use.",
    "day_first": true,
    "expiring_within_days": 90,
    "critical_within_days": 30,
    "notice_deadline_warning_days": 45,
    "effective_date_patterns": [
      "effective\\s+(?:as\\s+of\\s+|date[:\\s]+|on\\s+)(?P<date>[^.,;\\n)]{4,40})",
      "(?:commence|commences|commencing|start(?:s|ing)?)\\s+on\\s+(?P<date>[^.,;\\n)]{4,40})",
      "effective\\s+date\\s+of\\s+this\\s+agreement\\s+is\\s+(?P<date>[^.,;\\n)]{4,40})",
      "with\\s+effect\\s+from\\s+(?P<date>[^.,;\\n)]{4,40})"
    ],
    "expiration_date_patterns": [
      "(?:expire|expires|expiring|expiration\\s+date|end\\s+date|terminates)\\s*(?:on|:)?\\s+(?P<date>[^.,;\\n)]{4,40})",
      "(?:until|through|up\\s+to\\s+and\\s+including)\\s+(?P<date>[^.,;\\n)]{4,40})",
      "shall\\s+(?:continue|remain\\s+in\\s+(?:force|effect))\\s+until\\s+(?P<date>[^.,;\\n)]{4,40})",
      "initial\\s+term\\s+(?:shall\\s+)?end(?:s|ing)?\\s+on\\s+(?P<date>[^.,;\\n)]{4,40})"
    ],
    "renewal_date_patterns": [
      "renew(?:s|al|ed)?\\s+(?:automatically\\s+)?on\\s+(?P<date>[^.,;\\n)]{4,40})",
      "renewal\\s+date\\s*(?:is|:)?\\s+(?P<date>[^.,;\\n)]{4,40})",
      "next\\s+renewal\\s+(?:date\\s+)?(?:is|:)?\\s+(?P<date>[^.,;\\n)]{4,40})"
    ],
    "signature_date_patterns": [
      "(?:signed|executed|dated)\\s+(?:on|this)?\\s*(?P<date>[^.,;\\n)]{4,40})"
    ],
    "term_length_patterns": [
      "(?:initial\\s+)?term\\s+of\\s+(?P<count>\\d{1,3}|one|two|three|four|five|six|seven|eight|nine|ten|twelve|twenty-four|thirty-six)\\s+(?P<unit>days|day|weeks|week|months|month|years|year)",
      "for\\s+a\\s+period\\s+of\\s+(?P<count>\\d{1,3}|one|two|three|four|five|six|seven|eight|nine|ten|twelve|twenty-four|thirty-six)\\s+(?P<unit>days|day|weeks|week|months|month|years|year)"
    ],
    "renewal_term_patterns": [
      "(?:renew(?:s|ed|al|ing)?|extend(?:s|ed|ing)?)\\s+(?:automatically\\s+)?(?:for|by)\\s+(?:successive\\s+|additional\\s+|further\\s+|consecutive\\s+)*(?:periods?\\s+of\\s+)?(?P<count>\\d{1,3}|one|two|three|four|five|six|seven|eight|nine|ten|twelve|twenty-four|thirty-six)\\s+(?P<unit>days|day|weeks|week|months|month|years|year)",
      "(?:successive|additional|further)\\s+(?P<count>\\d{1,3}|one|two|three|four|five|six|seven|eight|nine|ten|twelve)[\\s\\-](?P<unit>days|day|weeks|week|months|month|years|year)\\s+(?:term|period)"
    ],
    "notice_period_patterns": [
      "(?:written\\s+)?notice\\s+(?:of\\s+)?(?:not\\s+less\\s+than\\s+|at\\s+least\\s+|a\\s+minimum\\s+of\\s+)?(?P<count>\\d{1,3}|one|two|three|four|five|six|seven|eight|nine|ten|twelve|thirty|sixty|ninety)[\\s\\-](?P<unit>days|day|weeks|week|months|month|years|year)",
      "(?:at\\s+least\\s+|not\\s+less\\s+than\\s+|a\\s+minimum\\s+of\\s+)(?P<count>\\d{1,3}|one|two|three|four|five|six|seven|eight|nine|ten|twelve|thirty|sixty|ninety)[\\s\\-](?P<unit>days|day|weeks|week|months|month|years|year)['\\u2019]?s?\\s+(?:prior\\s+)?(?:written\\s+)?notice",
      "(?P<count>\\d{1,3}|one|two|three|four|five|six|seven|eight|nine|ten|twelve|thirty|sixty|ninety)[\\s\\-](?P<unit>days|day|weeks|week|months|month)['\\u2019]?s?\\s+(?:prior\\s+)?(?:written\\s+)?notice"
    ],
    "number_words": {
      "one": 1,
      "two": 2,
      "three": 3,
      "four": 4,
      "five": 5,
      "six": 6,
      "seven": 7,
      "eight": 8,
