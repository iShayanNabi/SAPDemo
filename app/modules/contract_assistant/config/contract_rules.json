  "rules": {
    "CA-R001": {
      "name": "Auto-renewal clause present",
      "category": "Renewal",
      "enabled": true,
      "base_severity": "medium",
      "recommended_action": "Diarise the notice deadline and decide well before it whether to renew, renegotiate or exit.",
