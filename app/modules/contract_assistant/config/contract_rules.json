    "CA-R005": {
      "name": "Unlimited or uncapped liability",
      "category": "Liability",
      "enabled": true,
      "base_severity": "critical",
      "recommended_action": "Escalate to legal: unlimited liability is normally only acceptable for a defined, narrow set of breaches.",
