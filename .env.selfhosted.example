# SAPDemo - self-hosted deployment settings.
#
#     cp .env.selfhosted.example .env.selfhosted
#     # edit it, then:
#     ./scripts/start_selfhosted.sh
#
# `.env.selfhosted` is git-ignored. This example file is the only one committed,
# and it must never contain a real value for anything below marked SECRET.
#
# Read alongside:
#   docs/PUBLIC_DEMO_DEPLOYMENT.md   what each demonstration switch does
#   docs/CLOUDFLARE_TUNNEL_SETUP.md  where the tunnel token comes from
#   docs/DEMO_SECURITY_CHECKLIST.md  what to check before publishing

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
# JSON logs are easier to grep and harder to read. True for a deployment.
LOG_JSON=true

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# The database is never published: no host port, and its network has no route
# to the internet. The password still matters - it is the credential the API
# uses, and it ends up in DATABASE_URL below.
#
# SECRET. Generate one and do not reuse a password from anywhere else:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=sapdemo
POSTGRES_USER=sapdemo
POSTGRES_PASSWORD=replace-me-with-a-generated-password

# The API reaches the database by service name over the private network.
# Keep the user, password and database name here in step with the three above.
DATABASE_URL=postgresql+psycopg://sapdemo:replace-me-with-a-generated-password@database:5432/sapdemo

# ---------------------------------------------------------------------------
# Public demonstration mode
# ---------------------------------------------------------------------------
# DEMO_MODE=true is what makes this deployment safe to publish. It forces the
# mock AI provider, refuses uploads server-side, and puts the "Public Demo -
# Fictional Data Only" banner on every page.
DEMO_MODE=true

# Whether a visitor may upload their own file. False is the point of the mode.
# Setting this true on a public hostname means accepting arbitrary files from
# strangers into an application with no user accounts. Do not.
DEMO_ALLOW_UPLOADS=false

# Force the mock AI provider regardless of any key in the environment. Keeping
# this true is why the deployment needs no provider credential and costs
# nothing per request.
DEMO_USE_MOCK_AI=true

# Load the bundled demonstration records when the database holds none. A fresh
# volume comes up populated; a restart does nothing, because it is no longer
# empty.
DEMO_SEED_ON_EMPTY=true

# Wipe and reload on every container start. Leave this false. True means an
# ordinary restart - a Docker Desktop update, a power cut, a `docker compose
# restart` - destroys the database. Use scripts/reset_public_demo.sh when a
# reset is actually wanted.
DEMO_RESET_ON_START=false

# ---------------------------------------------------------------------------
# Public identity
# ---------------------------------------------------------------------------
# Used by the website (compiled into its pages at build time) and shown in the
# demonstration UI. All public; none of it is a secret.
#
# The public product is "Procurement Intelligence Demo", published under the
# "Solve AI Hub" brand. SAPDemo remains the internal name of this repository,
# the Python package and the Docker images - it is not a public label.
PUBLIC_SITE_NAME=Procurement Intelligence Demo
PUBLIC_SITE_URL=https://solveaihub.com
PUBLIC_DEMO_URL=https://demo.solveaihub.com
PUBLIC_CONTACT_EMAIL=solveaihub@gmail.com

# The public source repository, or blank for "there is not one".
#
# Blank is the current configuration and it is deliberate: the repository is
# private, so every "Source on GitHub" link, repository reference and source
# call to action on the website is hidden while this is unset. Blank and
# whitespace-only are treated exactly like unset - there is no way to
# half-configure it into rendering an empty link.
#
# Putting a valid https:// URL here and rebuilding the website image brings
# all of them back; nothing else has to change.
PUBLIC_REPOSITORY_URL=

# Optional, shown in the footer. Leave blank to omit it.
PUBLIC_LOCATION_LABEL=

# Whether the consulting Services page is linked from the navigation, the
# footer and the sitemap. Anything other than false/0/no/off leaves it linked.
SERVICES_PAGE_ENABLED=true

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# The website's only endpoint that accepts a write from an anonymous visitor.
# It is off by default, and everything below has to be present before it turns
# on. With CONTACT_FORM_ENABLED unset or false, the contact page renders the
# same mailto: links it always has and /api/contact returns 404.
#
# Fail-closed is the rule, not a nicety: setting CONTACT_FORM_ENABLED=true
# while any variable in this block is blank gives you the mailto: page again,
# and the server log names the missing variable. There is no partial state in
# which a form renders without an anti-spam check behind it.
#
# Nothing a visitor submits is stored. The message is emailed and dropped; no
# database row, no file, no log of its contents.
CONTACT_FORM_ENABLED=false

# The mailbox submissions are delivered to.
#
# Separate from PUBLIC_CONTACT_EMAIL above on purpose. That one is printed on
# the page and compiled into the browser bundle; this one is read only by the
# server. They are usually the same address - keeping them apart means routing
# form mail elsewhere never requires publishing the destination.
CONTACT_RECIPIENT_EMAIL=solveaihub@gmail.com

# SMTP delivery. SMTP_APP_PASSWORD is an App Password generated at
# https://myaccount.google.com/apppasswords - the account password will not
# work, and an App Password requires 2-Step Verification to be on.
#
# Port 465 is implicit TLS, which is what SMTP_SECURE=true selects. Port 587
# is STARTTLS, which mailer.ts requires rather than merely offers; either way
# the credential is never sent over an unencrypted connection.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=solveaihub@gmail.com
SMTP_APP_PASSWORD=
# Optional. Defaults to SMTP_USER. Gmail rewrites a From it does not own, so
# there is rarely a reason to change this - the visitor's address travels in
# Reply-To instead, where it does not break SPF and DMARC.
SMTP_FROM=

# Cloudflare Turnstile. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile
#
# The site key is public. It is passed twice - as a build argument, because
# next build compiles it into the browser bundle, and as a runtime variable,
# because the server-side readiness gate reads it too. Changing it still wants
# ./scripts/start_selfhosted.sh --build so the bundle matches. The secret key is
# read at run time only and must never become a build argument - Docker records
# build arguments in the image history.
#
# The name is NEXT_PUBLIC_TURNSTILE_SITE_KEY, matching frontend/.env.example and
# the code that reads it. PUBLIC_TURNSTILE_SITE_KEY was the earlier spelling and
# is still accepted by docker-compose.selfhosted.yml, so an existing deployment
# file keeps working; new ones should use the name below.
#
# Verification happens server-side on every submission and fails closed in
# every environment: a missing secret, a timeout, a malformed response or a
# rejected token all mean the message is not delivered. There is no NODE_ENV
# bypass. For local development Cloudflare publishes always-passing test keys
# (site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# How long the siteverify call may take before the submission is refused, in
# milliseconds. Read at run time, so a restart is enough to change it. Blank or
# malformed falls back to 5000 - never to "wait for ever", because the visitor
# is held on a form that has already failed and so is the request thread.
CONTACT_SITEVERIFY_TIMEOUT_MS=5000

# Which hostnames a token may have been solved on, and which action the widget
# declares. The site key is public - anyone can read it out of the page - so a
# `success` from Cloudflare only proves the token is genuine, not that it came
# from this form. These two make it specific. Blank skips the check.
TURNSTILE_EXPECTED_HOSTNAMES=solveaihub.com,www.solveaihub.com
TURNSTILE_EXPECTED_ACTION=contact

# Submissions allowed per window, counted in two independent buckets: one keyed
# on the visitor's network address, one on the email address they typed. Either
# going over rejects the request, so rotating addresses does not help.
#
# The two are charged at different points on purpose. The address bucket is
# charged on every attempt; the email bucket only *after* Turnstile has passed,
# because the email address is simply what somebody typed. Charging it earlier
# would let anyone type your address, send junk tokens until the bucket filled,
# and lock you out of the form for a whole window.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# HMAC key for those bucket identifiers. Any long random string:
#
#     openssl rand -hex 32
#
# It is what stops the in-memory keys being reversed back to an address. A bare
# SHA-256 of an IPv4 address is brute-forceable in seconds because the whole
# space is only 2^32, so the digest is keyed with a secret instead. Changing
# this resets the counters.
#
# The counters live in the Next.js process's memory: they reset on restart and
# are not shared between replicas, which is correct for this single-instance
# deployment and would need replacing with shared state before scaling out.
CONTACT_RATE_LIMIT_SECRET=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Empty, deliberately. The website never calls the API from a browser and
# Streamlit calls it server-side, so no origin needs to be allowed. Adding one
# here without a reason widens the API for nothing.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Cloudflare Tunnel
# ---------------------------------------------------------------------------
# SECRET. This single string authenticates a connector to the tunnel; anyone
# holding it can serve traffic as this deployment. It belongs only in
# .env.selfhosted on the host machine.
#
# Leave it blank until the pull request has been reviewed and the tunnel has
# actually been created in the Cloudflare dashboard. With it blank, the stack
# still starts and everything is testable through docker-compose.debug.yml -
# only the cloudflared container will restart in a loop, which
# scripts/verify_selfhosted.sh reports as expected rather than as a fault.
#
# Never paste a real token into a commit, a log, an issue or a screenshot.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# Where scripts/backup_selfhosted.sh writes. Point this at an external
# encrypted volume for anything you would mind losing; the default is a local
# directory that is git-ignored, which protects against a bad migration but not
# against the machine failing.
BACKUP_DIR=./backups
# How many backups to keep. The oldest beyond this are deleted by the backup
# script, which is the only thing that ever deletes a backup.
BACKUP_RETENTION=14

# ---------------------------------------------------------------------------
# Local debug ports (docker-compose.debug.yml only)
# ---------------------------------------------------------------------------
# Only used when the debug overlay is loaded. Every binding is to 127.0.0.1;
# see the comments in docker-compose.debug.yml for why that prefix matters.
DEBUG_WEBSITE_PORT=3000
DEBUG_STREAMLIT_PORT=8501
DEBUG_API_PORT=8000
