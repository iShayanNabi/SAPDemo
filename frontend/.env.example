# Public website configuration.
#
# Copy to .env.local for a local `npm run dev` or `npm run build`. The
# self-hosted deployment does not read this file - docker-compose.selfhosted.yml
# passes the same values as build arguments, derived from the PUBLIC_* entries
# in .env.selfhosted.
#
# Nothing here is a secret. NEXT_PUBLIC_* values are compiled into the browser
# bundle by `next build` by definition, so only public addresses belong in this
# file. A change to any of them needs a rebuild, not a restart.
#
# Blank and whitespace-only are treated as "not set" for every value below.
# That is not a detail: Docker supplies a defined empty string rather than an
# absent variable, so a fallback that only handles `undefined` never fires.

# The public site address. Used for canonical URLs and Open Graph.
NEXT_PUBLIC_SITE_URL=https://solveaihub.com

# Where every Launch Demo button points. The demonstration is protected by
# Cloudflare Access.
NEXT_PUBLIC_DEMO_URL=https://demo.solveaihub.com

# The single public contact address. Every mailto: on the site uses it.
NEXT_PUBLIC_CONTACT_EMAIL=solveaihub@gmail.com

# The public source repository, or blank for "there is not one".
#
# Blank is the current configuration: the repository is private, so every
# source link on the site is hidden. A valid https:// URL brings them back.
NEXT_PUBLIC_REPOSITORY_URL=

# Optional, shown in the footer. Blank omits it.
NEXT_PUBLIC_LOCATION_LABEL=

# Not a NEXT_PUBLIC_ value, deliberately: it is read while the pages are
# rendered and never reaches the browser. Anything other than false/0/no/off
# leaves the Services page linked from the navigation, footer and sitemap.
SERVICES_PAGE_ENABLED=true
