# Public website configuration.
#
# Copy to .env.local for a local `npm run dev` or `npm run build`. The
# self-hosted deployment does not read this file - docker-compose.selfhosted.yml
# passes the same values as build arguments, derived from the PUBLIC_* entries
# in .env.selfhosted.
#
# Nothing here is a secret. NEXT_PUBLIC_* values are compiled into the browser
# bundle by `next build` by definition, so only public addresses belong in this
# file. A change to any of them needs a rebuild, not a restart.
#
# Blank and whitespace-only are treated as "not set" for every value below.
# That is not a detail: Docker supplies a defined empty string rather than an
# absent variable, so a fallback that only handles `undefined` never fires.

# The public site address. Used for canonical URLs and Open Graph.
NEXT_PUBLIC_SITE_URL=https://solveaihub.com

# Where every Launch Demo button points. The demonstration is protected by
# Cloudflare Access.
NEXT_PUBLIC_DEMO_URL=https://demo.solveaihub.com

# The single public contact address. Every mailto: on the site uses it.
NEXT_PUBLIC_CONTACT_EMAIL=solveaihub@gmail.com

# The public source repository, or blank for "there is not one".
#
# Blank is the current configuration: the repository is private, so every
# source link on the site is hidden. A valid https:// URL brings them back.
NEXT_PUBLIC_REPOSITORY_URL=

# Optional, shown in the footer. Blank omits it.
NEXT_PUBLIC_LOCATION_LABEL=

# Not a NEXT_PUBLIC_ value, deliberately: it is read while the pages are
# rendered and never reaches the browser. Anything other than false/0/no/off
# leaves the Services page linked from the navigation, footer and sitemap.
SERVICES_PAGE_ENABLED=true

# ---------------------------------------------------------------------------
# Contact form - everything below IS a secret except the site key
# ---------------------------------------------------------------------------
# The paragraph at the top of this file stops applying here. These are read by
# the server at run time and never compiled into the bundle, which is only true
# because none of them is prefixed NEXT_PUBLIC_ and because nothing under
# lib/contact/ except validation.ts is imported by a client component. Adding
# the prefix to any variable below would publish it to every visitor.
#
# Off by default. Blank or false leaves the contact page exactly as it is
# without this block: mailto: links, and /api/contact returning 404. Setting it
# true with anything else here missing does the same and logs what is absent.
CONTACT_FORM_ENABLED=false

# Where submissions are delivered. Server-side only, unlike
# NEXT_PUBLIC_CONTACT_EMAIL above, which is the address printed on the page.
CONTACT_RECIPIENT_EMAIL=solveaihub@gmail.com

# SMTP_APP_PASSWORD is a Gmail App Password
# (https://myaccount.google.com/apppasswords), not the account password. 465 is
# implicit TLS and wants SMTP_SECURE=true; 587 is STARTTLS, which is required
# rather than optional. SMTP_FROM is optional and defaults to SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=solveaihub@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM=

# Cloudflare Turnstile. The site key is public and compiled in - a change needs
# a rebuild. The secret is verified server-side on every submission and fails
# closed everywhere, with no NODE_ENV bypass.
#
# These are Cloudflare's published always-pass test credentials, which is what
# makes `npm run dev` work without a Cloudflare account. Replace both for any
# deployment: the test secret accepts every token, including a forged one.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Which hostnames a token may have been solved on, and which action the widget
# declares. Left blank here because Cloudflare's test keys report neither
# meaningfully; a deployment sets both (solveaihub.com,www.solveaihub.com and
# contact) so a token solved on somebody else's page under the same public site
# key cannot be replayed here. Blank skips the check; success is still required.
TURNSTILE_EXPECTED_HOSTNAMES=
TURNSTILE_EXPECTED_ACTION=

# Submissions per window, counted separately per client address and per
# submitted email address. The address bucket is charged on every attempt; the
# email bucket only after Turnstile passes - see lib/contact/rate-limit.ts.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# HMAC key for those bucket identifiers - `openssl rand -hex 32`. Keyed rather
# than a bare hash because an unkeyed digest of an IPv4 address is reversible
# by exhaustive search. Counters are in-process memory only: they reset on
# restart and do not span replicas.
CONTACT_RATE_LIMIT_SECRET=local-development-only-not-a-real-secret
